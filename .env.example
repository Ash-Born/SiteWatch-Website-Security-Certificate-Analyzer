# Copy to .env and replace every secret before deployment.
JWT_SECRET=replace-with-at-least-32-random-characters
SCAN_ACCESS_KEY=replace-with-a-private-scan-key
BOOTSTRAP_ADMIN_USERNAME=ADMIN
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-root-password
MYSQL_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=mysql+pymysql://scanner:replace-me@127.0.0.1:3307/website_audit
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
AVATAR_STORAGE_DIR=uploads/avatars
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SCHEDULE_POLL_SECONDS=30
HOST=0.0.0.0
PORT=8000
